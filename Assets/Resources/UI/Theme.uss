/* =====================================================================
   Theme.uss — UI Toolkit 전역 테마 (팔레트 + 폰트 + 공통 컴포넌트)
   Phase U0 (인프라) — 참조: docs/UI_TOOLKIT_MIGRATION.md / docs/UI_DESIGN_GUIDELINES.md

   팔레트: UI_DESIGN_GUIDELINES.md 62차 확정값.
   희귀도 등급색: EquipmentRarityData.GetRarityColor() (Core 계층) 통일.
   폰트: 기존 UIFont 체계 승격 (Assets/Resources/Fonts/NotoSansKR-VF.ttf)
         실제 폰트 에셋 할당은 코드(UTKWindowBase.ApplyFont)에서 수행.
   ===================================================================== */

:root {
    /* ---- 팔레트 (UI_DESIGN_GUIDELINES 62차) ---- */
    /* ---- 다크 브라운 아크릴 + 앤틱 골드 (2026-09-18 사용자 지정 — 중세 판타지) ---- */
    --c-bg-panel:      rgba(38, 26, 16, 0.84);    /* 딥 우드 아크릴 (반투명 — 뒤가 은은히 비침) */
    --c-bg-panel-dark: rgba(26, 17, 10, 0.90);    /* 심층 우드 */
    --c-border-bronze: #B08D4A;                    /* 앤틱 골드/황동 메탈 라인 */
    --c-border-gold:   #E8C877;                    /* 브라이트 골드 강조 */
    --c-iron-line:     rgba(140, 107, 63, 0.45);   /* 미세 우드 구분선 */
    --c-text-primary:  #FFF4E0;                    /* 웜 화이트 */
    --c-text-secondary:#C8B89A;                    /* 뮤트 골드 그레이 */
    --c-accent-magic:  #7FA8E0;                    /* 마법 강조 (차분한 블루) */
    --c-accent-rare:   #E8C877;                    /* 골드 강조 */
    --c-health-red:    #D05050;                    /* HP/위험 */
    --c-guild-green:   #7FB069;                    /* 성공 */
    --c-hover-gold:    rgba(201, 162, 39, 0.40);   /* 호버 골드 글로우 */

    /* ---- 희귀도 등급색 (EquipmentRarityData 통일) ---- */
    --c-rank-common:    #999999;   /* 일반 */
    --c-rank-uncommon:  #33CC33;   /* 고급 */
    --c-rank-rare:      #3366FF;   /* 희귀 */
    --c-rank-epic:      #9933FF;   /* 영웅 */
    --c-rank-legendary: #FF3333;   /* 전설 */
    --c-rank-unique:    #FFD900;   /* 유니크 */

    /* ---- 폰트 타입스케일 5단 (UIFont: Display/Title/Body/Caption/Badge) ---- */
    --fs-xl: 60px;
    --fs-lg: 38px;
    --fs-md: 24px;
    --fs-sm: 17px;
    --fs-xs: 13px;
}

/* ───────────────────────── 윈도우 ───────────────────────── */
.utk-window {
    position: absolute;
    background-color: var(--c-bg-panel);
    /* 입체(A): 상단 밝은 우드 → 하단 어두운 우드 세로 부피감 */
    /* U9-W1 수리: linear-gradient는 Unity 6에서 Function으로 파싱되어
       "Invalid value for image texture Function" 경고 + 렌더 미적용의 뿌리.
       → 동일 색상/알파를 베이크한 PNG로 교체 (그림자 9슬라이스와 동일 기법) */
    background-image: url("bg_window.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-width: 2px;
    border-color: var(--c-border-bronze);
    /* 입체(B): 금속 테두리 베벨 — 상단/좌측 어둡게(후퇴), 하단/우측 황동(전진) */
    border-top-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: var(--c-border-bronze);
    border-right-color: var(--c-border-bronze);
    border-radius: 8px;
    color: var(--c-text-primary);
    font-size: var(--fs-sm);
    overflow: hidden;
}

/* 부드러운 소프트 그림자(드롭섀도우) — 9슬라이스 글로우 배경.
   UIRoot 최상위 부모에 형제 요소로 얹혀 창 뒤에 그려짐 (overflow:hidden에 안 잘림).
   pointer-events:none으로 드래그/클릭/드롭타겟 간섭 없음. */
.utk-window-shadow {
    position: absolute;
    background-image: url("shadow_glow.png");
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-background-scale-mode: slice-enabled;
    background-size: 100% 100%;
    pointer-events: none;
}

.utk-title-bar {
    flex-direction: row;
    align-items: center;
    background-color: var(--c-bg-panel-dark);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-iron-line);
    padding: 6px 8px;
    flex-shrink: 0;
}

.utk-title-label {
    flex-grow: 1;
    font-size: var(--fs-lg);
    color: var(--c-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.utk-close-btn {
    width: 28px;
    height: 28px;
    font-size: var(--fs-md);
    color: var(--c-text-primary);
    background-color: var(--c-bg-panel-dark);
    border-width: 1px;
    border-color: var(--c-iron-line);
    border-radius: 2px;
    flex-shrink: 0;
}

.utk-close-btn:hover {
    background-color: var(--c-health-red);
    color: white;
}

.utk-content {
    flex-grow: 1;
    padding: 10px;
    overflow: visible;
}

/* ───────────────────────── 버튼 ───────────────────────── */
.utk-btn {
    font-size: var(--fs-sm);
    color: var(--c-text-primary);
    background-color: var(--c-bg-panel-dark);
    /* 입체(A): 미세한 세로 부피감 */
    background-image: url("bg_button.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-width: 1px;
    border-color: var(--c-border-bronze);
    /* 입체(E): 버튼 양각 베벨 — 상단/좌측 어둡게, 하단/우측 황동 */
    border-top-color: rgba(0, 0, 0, 0.40);
    border-left-color: rgba(0, 0, 0, 0.40);
    border-bottom-color: var(--c-border-bronze);
    border-right-color: var(--c-border-bronze);
    border-radius: 3px;
    padding: 4px 14px;
    align-items: center;
    justify-content: center;
}

.utk-btn:hover {
    background-color: var(--c-hover-gold);
    /* 입체(D): 호버 시 배경 밝기 + 골드 글로우 강조 */
    background-image: url("bg_button_hover.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-top-color: var(--c-hover-gold);
    border-left-color: var(--c-hover-gold);
    border-bottom-color: var(--c-border-gold);
    border-right-color: var(--c-border-gold);
    color: #201A10;
}

.utk-btn:active {
    border-color: var(--c-border-gold);
}

.utk-btn--primary {
    background-color: var(--c-accent-magic);
    color: white;
    border-color: var(--c-accent-magic);
}

.utk-btn--secondary {
    background-color: var(--c-bg-panel-dark);
}

.utk-btn--danger {
    background-color: var(--c-health-red);
    color: white;
    border-color: var(--c-health-red);
}

.utk-btn:disabled {
    opacity: 0.4;
    color: var(--c-text-secondary);
}

/* ───────────────────────── 슬롯 ───────────────────────── */
.utk-slot {
    width: 64px;
    height: 64px;
    background-color: rgba(14, 9, 5, 0.72);          /* 음각(오목) 느낌의 어두운 내부 */
    /* 입체(C): 내부 인셋 그라데이션 — 상단 약간 밝음 → 하단 더 캄캄해 음각 심화 */
    background-image: url("bg_slot.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-top-width: 2px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(0, 0, 0, 0.55);           /* 상단 어둡게 — 오목 광원 역광 */
    border-left-color: rgba(0, 0, 0, 0.55);
    border-bottom-color: rgba(176, 141, 74, 0.55);   /* 하단 골드 — 오목 하이라이트 */
    border-right-color: rgba(176, 141, 74, 0.55);
    border-radius: 4px;
    margin: 3px;
}

.utk-slot--hover {
    background-color: rgba(217, 180, 91, 0.22);      /* 입체(D): 호버 배경 밝게 */
    /* [P16-3 수리] 글로우 9슬라이스 — stretch는 모서리가 늘어나 아이콘 반쪽 짤림처럼 보였다 */
    background-image: url("glow_hover_gold.png");
    -unity-background-scale-mode: slice-enabled;
    -unity-slice-left: 48px;
    -unity-slice-top: 48px;
    -unity-slice-right: 48px;
    -unity-slice-bottom: 48px;
    border-top-color: var(--c-hover-gold);
    border-left-color: var(--c-hover-gold);
    border-bottom-color: var(--c-border-gold);
    border-right-color: var(--c-border-gold);
}

.utk-slot__icon {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.utk-slot__count {
    font-size: var(--fs-xs);
    color: var(--c-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-right: 3px;
    margin-bottom: 2px;
}

/* 선택된 레시피 행 강조 */
.utk-selected-row {
    background-color: rgba(217, 180, 91, 0.18);
    border-left-width: 3px;
    border-left-color: var(--c-hover-gold);
    border-top-width: 1px;
    border-top-color: var(--c-iron-line);
}

/* 희귀도 테두리 오라 */
.utk-rank--common    { border-color: var(--c-rank-common); }
.utk-rank--uncommon  { border-color: var(--c-rank-uncommon); }
.utk-rank--rare      { border-color: var(--c-rank-rare); }
.utk-rank--epic      { border-color: var(--c-rank-epic); }
.utk-rank--legendary { border-color: var(--c-rank-legendary); }
.utk-rank--unique    { border-color: var(--c-rank-unique); }

/* ───────────────────────── 툴팁 / 모달 / 토스트 ───────────────────────── */
.utk-tooltip {
    position: absolute;
    background-color: var(--c-bg-panel-dark);
    /* 입체(A): 세로 부피감 */
    background-image: url("bg_tooltip.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-width: 1px;
    border-color: var(--c-border-bronze);
    border-top-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: var(--c-border-bronze);
    border-right-color: var(--c-border-bronze);
    border-radius: 3px;
    padding: 6px 10px;
    font-size: var(--fs-xs);
    color: var(--c-text-primary);
    max-width: 300px;
    pointer-events: none;
}

.utk-modal {
    position: absolute;
    background-color: var(--c-bg-panel);
    /* 입체(A): 세로 부피감 */
    background-image: url("bg_window.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-width: 2px;
    border-color: var(--c-border-gold);
    /* 입체(B): 금속 베벨 — 상단/좌측 어둡게, 하단/우측 브라이트 골드 */
    border-top-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: var(--c-border-gold);
    border-right-color: var(--c-border-gold);
    border-radius: 4px;
    padding: 16px;
    min-width: 260px;
}

.utk-modal__overlay {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.5);
}

.utk-toast {
    position: absolute;
    background-color: var(--c-bg-panel-dark);
    /* 입체(A): 세로 부피감 + 금속 베벨 */
    background-image: url("bg_tooltip.png");
    -unity-background-scale-mode: stretch-and-crop;
    border-width: 1px;
    border-color: var(--c-border-bronze);
    border-top-color: rgba(0, 0, 0, 0.35);
    border-left-color: rgba(0, 0, 0, 0.35);
    border-bottom-color: var(--c-border-bronze);
    border-right-color: var(--c-border-bronze);
    border-radius: 4px;
    padding: 8px 16px;
    font-size: var(--fs-sm);
    color: var(--c-text-primary);
}

.utk-toast--fadeout {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}