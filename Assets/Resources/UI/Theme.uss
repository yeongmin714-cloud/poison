/* =====================================================================
   Theme.uss — UI Toolkit 전역 테마 (팔레트 + 폰트 + 공통 컴포넌트)
   Phase U0 (인프라) — 참조: docs/UI_TOOLKIT_MIGRATION.md / docs/UI_DESIGN_GUIDELINES.md

   팔레트: UI_DESIGN_GUIDELINES.md 62차 확정값.
   희귀도 등급색: EquipmentRarityData.GetRarityColor() (Core 계층) 통일.
   폰트: 기존 UIFont 체계 승격 (Assets/Resources/Fonts/NotoSansKR-VF.ttf)
         실제 폰트 에셋 할당은 코드(UTKWindowBase.ApplyFont)에서 수행.
   ===================================================================== */

:root {
    /* ---- 팔레트 (UI_DESIGN_GUIDELINES 62차) ---- */
    --c-bg-panel:      rgba(28, 28, 28, 0.878);   /* #1C1C1C @ E0 */
    --c-bg-panel-dark: rgba(20, 20, 20, 0.910);   /* #141414 @ E8 */
    --c-border-bronze: #8C6B3F;                    /* 브론즈 */
    --c-border-gold:   #C9A227;                    /* 골드 */
    --c-iron-line:     #3A3A3A;                    /* 철분리선 */
    --c-text-primary:  #F5EFE0;                    /* 본문 */
    --c-text-secondary:#B9B3A6;                    /* 보조 */
    --c-accent-magic:  #4A7BD0;                    /* 마법 강조 */
    --c-accent-rare:   #E7B73A;                    /* 희귀 강조 */
    --c-health-red:    #C83838;                    /* HP/위험 */
    --c-guild-green:   #5E8C4A;                    /* 길드/성공 */
    --c-hover-gold:    #D9B45B;                    /* 호버 */

    /* ---- 희귀도 등급색 (EquipmentRarityData 통일) ---- */
    --c-rank-common:    #999999;   /* 일반 */
    --c-rank-uncommon:  #33CC33;   /* 고급 */
    --c-rank-rare:      #3366FF;   /* 희귀 */
    --c-rank-epic:      #9933FF;   /* 영웅 */
    --c-rank-legendary: #FF3333;   /* 전설 */
    --c-rank-unique:    #FFD900;   /* 유니크 */

    /* ---- 폰트 타입스케일 5단 (UIFont: Display/Title/Body/Caption/Badge) ---- */
    --fs-xl: 60px;
    --fs-lg: 38px;
    --fs-md: 24px;
    --fs-sm: 17px;
    --fs-xs: 13px;
}

/* ───────────────────────── 윈도우 ───────────────────────── */
.utk-window {
    position: absolute;
    background-color: var(--c-bg-panel);
    border-width: 2px;
    border-color: var(--c-border-bronze);
    border-radius: 4px;
    color: var(--c-text-primary);
    font-size: var(--fs-sm);
    overflow: hidden;
    /* 그림자 근사 */
}

.utk-title-bar {
    flex-direction: row;
    align-items: center;
    background-color: var(--c-bg-panel-dark);
    border-bottom-width: 1px;
    border-bottom-color: var(--c-iron-line);
    padding: 6px 8px;
    flex-shrink: 0;
}

.utk-title-label {
    flex-grow: 1;
    font-size: var(--fs-lg);
    color: var(--c-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.utk-close-btn {
    width: 28px;
    height: 28px;
    font-size: var(--fs-md);
    color: var(--c-text-primary);
    background-color: var(--c-bg-panel-dark);
    border-width: 1px;
    border-color: var(--c-iron-line);
    border-radius: 2px;
    flex-shrink: 0;
}

.utk-close-btn:hover {
    background-color: var(--c-health-red);
    color: white;
}

.utk-content {
    flex-grow: 1;
    padding: 10px;
    overflow: visible;
}

/* ───────────────────────── 버튼 ───────────────────────── */
.utk-btn {
    font-size: var(--fs-sm);
    color: var(--c-text-primary);
    background-color: var(--c-bg-panel-dark);
    border-width: 1px;
    border-color: var(--c-border-bronze);
    border-radius: 3px;
    padding: 4px 14px;
    align-items: center;
    justify-content: center;
}

.utk-btn:hover {
    background-color: var(--c-hover-gold);
    color: #201A10;
}

.utk-btn:active {
    border-color: var(--c-border-gold);
}

.utk-btn--primary {
    background-color: var(--c-accent-magic);
    color: white;
    border-color: var(--c-accent-magic);
}

.utk-btn--secondary {
    background-color: var(--c-bg-panel-dark);
}

.utk-btn--danger {
    background-color: var(--c-health-red);
    color: white;
    border-color: var(--c-health-red);
}

.utk-btn:disabled {
    opacity: 0.4;
    color: var(--c-text-secondary);
}

/* ───────────────────────── 슬롯 ───────────────────────── */
.utk-slot {
    background-color: var(--c-bg-panel-dark);
    border-width: 1px;
    border-color: var(--c-iron-line);
    border-radius: 3px;
    align-items: center;
    justify-content: center;
}

.utk-slot--hover {
    background-color: rgba(217, 180, 91, 0.15);
    border-color: var(--c-hover-gold);
}

.utk-slot__icon {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.utk-slot__count {
    font-size: var(--fs-xs);
    color: var(--c-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-right: 3px;
    margin-bottom: 2px;
}

/* 희귀도 테두리 오라 */
.utk-rank--common    { border-color: var(--c-rank-common); }
.utk-rank--uncommon  { border-color: var(--c-rank-uncommon); }
.utk-rank--rare      { border-color: var(--c-rank-rare); }
.utk-rank--epic      { border-color: var(--c-rank-epic); }
.utk-rank--legendary { border-color: var(--c-rank-legendary); }
.utk-rank--unique    { border-color: var(--c-rank-unique); }

/* ───────────────────────── 툴팁 / 모달 / 토스트 ───────────────────────── */
.utk-tooltip {
    position: absolute;
    background-color: var(--c-bg-panel-dark);
    border-width: 1px;
    border-color: var(--c-border-bronze);
    border-radius: 3px;
    padding: 6px 10px;
    font-size: var(--fs-xs);
    color: var(--c-text-primary);
    max-width: 300px;
    pointer-events: none;
}

.utk-modal {
    position: absolute;
    background-color: var(--c-bg-panel);
    border-width: 2px;
    border-color: var(--c-border-gold);
    border-radius: 4px;
    padding: 16px;
    min-width: 260px;
}

.utk-modal__overlay {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.5);
}

.utk-toast {
    position: absolute;
    background-color: var(--c-bg-panel-dark);
    border-width: 1px;
    border-color: var(--c-border-bronze);
    border-radius: 4px;
    padding: 8px 16px;
    font-size: var(--fs-sm);
    color: var(--c-text-primary);
}

.utk-toast--fadeout {
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}